---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout locale="en" title="Page not found · Santiago Olayo" noindex>
  <Header locale="en" isHomePage={false} />
  <main class="notFound">
    <p class="eyebrow">404</p>
    <h1 class="title">This page doesn’t exist.</h1>
    <p class="lead">
      The link may be broken or the page may have moved. <span lang="es">La página no existe.</span>
    </p>
    <div class="actions">
      <a href="/" class="primary">Back to portfolio</a>
      <a href="/es/" class="secondary" hreflang="es">Ir al portafolio</a>
    </div>
  </main>
  <Footer locale="en" isHomePage={false} />
</BaseLayout>

<style>
  .notFound {
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8rem 1.5rem 5rem;
  }

  .eyebrow {
    font-family: var(--font-family-mono);
    font-size: 0.85rem;
    color: var(--apple-text-tertiary);
    margin-bottom: 0.9rem;
  }

  .title {
    font-family: var(--font-family-display);
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.06;
    color: var(--apple-text-primary);
  }

  .lead {
    margin-top: 1rem;
    max-width: 34rem;
    color: var(--apple-text-secondary);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    min-height: 2.8rem;
    padding: 0.7rem 1.5rem;
    border-radius: var(--radius-pill);
    font-size: 0.95rem;
    font-weight: 500;
    transition:
      transform var(--transition-fast),
      background-color var(--transition-fast);
  }

  .primary {
    background: var(--apple-accent);
    color: #ffffff;
  }

  .primary:hover {
    background: var(--apple-accent-hover);
    transform: scale(1.02);
  }

  .secondary {
    background: var(--apple-bg-stone);
    color: var(--apple-text-primary);
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .secondary:hover {
    background: #e8e8ed;
    transform: scale(1.02);
  }
</style>
