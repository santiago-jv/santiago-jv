# Server-only secrets (NEVER prefix with NEXT_PUBLIC_)
# Copy this file to .env.local for local testing. .env.local is ignored by Git.
# In production, configure these in Vercel -> Project Settings -> Environment Variables (Encrypted).

# Create a Restricted API Key in Resend with "Sending access" ONLY for domain santiago-jv.tech:
RESEND_API_KEY=

# Destination inbox and verified sender address on santiago-jv.tech:
CONTACT_TO_EMAIL=contact@santiago-jv.tech
CONTACT_FROM_EMAIL=Santiago Portfolio <noreply@santiago-jv.tech>
